{
  "publisher": "futuregirlfriendps",
  "name": "futuregirlfriendps-vscode",
  "version": "0.1.0",
  "displayName": "FutureGirlfriendPS - Problem Solving Companion",
  "description": "IDE-first PS/self-reflection coaching with anti-solution pedagogy. A fork of Rubberduck for personalized programming problem solving guidance.",
  "keywords": [
    "ai",
    "problem solving",
    "ps",
    "coaching",
    "debugging",
    "learning"
  ],
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Linters",
    "Formatters",
    "Data Science",
    "Education",
    "Testing"
  ],
  "icon": "media/extension-icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "node": ">=18",
    "vscode": "^1.72.0"
  },
  "homepage": "https://github.com/yourusername/futuregirlfriendps-vscode",
  "repository": "https://github.com/yourusername/futuregirlfriendps-vscode",
  "bugs": "https://github.com/yourusername/futuregirlfriendps-vscode/issues",
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension/dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rubberduck.startChat",
        "title": "Start Chat 💬",
        "category": "Rubberduck",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "rubberduck.editCode",
        "title": "Edit Code 🖊️",
        "category": "Rubberduck",
        "icon": "$(edit)"
      },
      {
        "command": "rubberduck.explainCode",
        "title": "Explain Code 💬",
        "category": "Rubberduck",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "rubberduck.generateCode",
        "title": "Generate Code 🪄",
        "category": "Rubberduck",
        "icon": "$(wand)"
      },
      {
        "command": "rubberduck.generateUnitTest",
        "title": "Generate Unit Test 🪄",
        "category": "Rubberduck",
        "icon": "$(beaker)"
      },
      {
        "command": "rubberduck.diagnoseErrors",
        "title": "Diagnose Errors 💬",
        "category": "Rubberduck",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "rubberduck.findBugs",
        "title": "Find Bugs 💬",
        "category": "Rubberduck",
        "icon": "$(bug)"
      },
      {
        "command": "rubberduck.startCustomChat",
        "title": "Start Custom Chat… 💬",
        "category": "Rubberduck",
        "icon": "$(comment-draft)"
      },
      {
        "command": "rubberduck.touchBar.startChat",
        "category": "Rubberduck",
        "title": "💬"
      },
      {
        "command": "rubberduck.showChatPanel",
        "title": "Show Chat Panel 💬",
        "category": "Rubberduck",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "rubberduck.getStarted",
        "title": "Get Started",
        "category": "Rubberduck",
        "icon": "$(question)"
      },
      {
        "command": "rubberduck.reloadTemplates",
        "title": "Reload Templates",
        "category": "Rubberduck",
        "icon": "$(sync)"
      },
      {
        "command": "rubberduck.showLogs",
        "title": "Show Logs",
        "category": "Rubberduck",
        "icon": "$(output)"
      },
      {
        "command": "rubberduck.indexRepository",
        "title": "Index Repository",
        "category": "Rubberduck",
        "enablement": "config.rubberduck.indexRepository.enabled"
      }
    ],
    "configuration": {
      "title": "FutureGirlfriendPS",
      "properties": {
        "futureGirlfriendPs.backendUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "markdownDescription": "URL of the backend server that handles chat requests. Default is http://localhost:3000 for local development.",
          "scope": "application"
        },
        "futureGirlfriendPs.defaultMode": {
          "type": "string",
          "default": "debug",
          "enum": [
            "debug",
            "explain",
            "learn",
            "reveal"
          ],
          "enumDescriptions": [
            "Debugging Mode: Ask targeted questions, propose print-debug strategies, suggest edge-case tests",
            "Explain-Your-Code Mode: Forces user narration, points out logical holes",
            "Learn-Together Mode: Mini-lesson + micro-exercise, then apply",
            "Reveal Mode (gated): Only after attempts; still avoids dumping full code"
          ],
          "markdownDescription": "Default mode for new conversations",
          "scope": "application"
        },
        "futureGirlfriendPs.defaultHintLevel": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 4,
          "markdownDescription": "Default hint level (0=reflect+question, 1=assumption check, 2=experiment, 3=suspicious region, 4=pseudocode/insight)",
          "scope": "application"
        },
        "rubberduck.syntaxHighlighting.useVisualStudioCodeColors": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use the Visual Studio Code Theme colors for syntax highlighting in the diff viewer. Might not work with all themes. Only applies to newly opened diffs.",
          "scope": "application"
        },
        "rubberduck.action.editCode.showInEditorContextMenu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show this action in the editor context menu, when you right-click on the code.",
          "scope": "application"
        },
        "rubberduck.action.startChat.showInEditorContextMenu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show this action in the editor context menu, when you right-click on the code.",
          "scope": "application"
        },
        "rubberduck.action.explainCode.showInEditorContextMenu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show this action in the editor context menu, when you right-click on the code.",
          "scope": "application"
        },
        "rubberduck.action.findBugs.showInEditorContextMenu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show this action in the editor context menu, when you right-click on the code.",
          "scope": "application"
        },
        "rubberduck.action.generateUnitTest.showInEditorContextMenu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show this action in the editor context menu, when you right-click on the code.",
          "scope": "application"
        },
        "rubberduck.action.diagnoseErrors.showInEditorContextMenu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show this action in the editor context menu, when you right-click on the code.",
          "scope": "application"
        },
        "rubberduck.action.startCustomChat.showInEditorContextMenu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show this action in the editor context menu, when you right-click on the code.",
          "scope": "application"
        },
        "rubberduck.logger.level": {
          "type": "string",
          "default": "info",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ],
          "enumDescriptions": [
            "Show all logs",
            "Show all logs except the debug ones",
            "Only show warnings and errors",
            "Only show errors"
          ],
          "markdownDescription": "Specify the verbosity of logs that will appear in 'Rubberduck: Show Logs'.",
          "scope": "application"
        },
        "rubberduck.openAI.surfacePromptForPlus": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable UI to surface the prompt text to use with OpenAI plus web chat",
          "scope": "application"
        }
      }
    },
    "keybindings": [
      {
        "command": "rubberduck.startChat",
        "when": "isMac",
        "key": "Ctrl+Cmd+c"
      },
      {
        "command": "rubberduck.startChat",
        "when": "!isMac",
        "key": "Ctrl+Alt+c"
      },
      {
        "command": "rubberduck.editCode",
        "when": "isMac",
        "key": "Ctrl+Cmd+e"
      },
      {
        "command": "rubberduck.editCode",
        "when": "!isMac",
        "key": "Ctrl+Alt+e"
      },
      {
        "command": "rubberduck.generateCode",
        "when": "isMac",
        "key": "Ctrl+Cmd+g"
      },
      {
        "command": "rubberduck.generateCode",
        "when": "!isMac",
        "key": "Ctrl+Alt+g"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rubberduck.startChat",
          "when": "view == rubberduck.chat",
          "group": "navigation@1"
        },
        {
          "command": "rubberduck.editCode",
          "when": "view == rubberduck.chat",
          "group": "navigation@2"
        },
        {
          "command": "rubberduck.generateCode",
          "when": "view == rubberduck.chat",
          "group": "navigation@3"
        },
        {
          "command": "rubberduck.startCustomChat",
          "when": "view == rubberduck.chat",
          "group": "navigation@6"
        },
        {
          "command": "rubberduck.getStarted",
          "when": "view == rubberduck.chat",
          "group": "navigation@9"
        }
      ],
      "touchBar": [
        {
          "command": "rubberduck.touchBar.startChat",
          "group": "rubberduck"
        }
      ],
      "commandPalette": [
        {
          "command": "rubberduck.touchBar.startChat",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "rubberduck.startChat",
          "group": "rubberduck",
          "when": "config.rubberduck.action.startChat.showInEditorContextMenu && editorHasSelection"
        },
        {
          "command": "rubberduck.editCode",
          "group": "rubberduck",
          "when": "config.rubberduck.action.editCode.showInEditorContextMenu && editorHasSelection"
        },
        {
          "command": "rubberduck.explainCode",
          "group": "rubberduck",
          "when": "config.rubberduck.action.explainCode.showInEditorContextMenu && editorHasSelection"
        },
        {
          "command": "rubberduck.findBugs",
          "group": "rubberduck",
          "when": "config.rubberduck.action.findBugs.showInEditorContextMenu && editorHasSelection"
        },
        {
          "command": "rubberduck.generateUnitTest",
          "group": "rubberduck",
          "when": "config.rubberduck.action.generateUnitTest.showInEditorContextMenu && editorHasSelection"
        },
        {
          "command": "rubberduck.diagnoseErrors",
          "group": "rubberduck",
          "when": "config.rubberduck.action.diagnoseErrors.showInEditorContextMenu && editorHasSelection"
        },
        {
          "command": "rubberduck.startCustomChat",
          "group": "rubberduck",
          "when": "config.rubberduck.action.startCustomChat.showInEditorContextMenu && editorHasSelection"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rubberduck",
          "title": "Rubberduck",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "rubberduck": [
        {
          "id": "rubberduck.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "rubberduck",
        "title": "Rubberduck",
        "description": "Your AI Chat Assistant in Visual Studio Code",
        "steps": [
          {
            "id": "setup",
            "title": "Setup Rubberduck",
            "description": "[Enter your OpenAI API key](command:rubberduck.enterOpenAIApiKey) to get started.",
            "media": {
              "markdown": "walkthrough/setup.md"
            }
          },
          {
            "id": "chat",
            "title": "AI Chat",
            "description": "Chat with Rubberduck about your code and software development topics.",
            "media": {
              "markdown": "walkthrough/chat.md"
            }
          },
          {
            "id": "generate-code",
            "title": "Generate Code",
            "description": "Generate code by instructing Rubberduck.",
            "media": {
              "markdown": "walkthrough/generate-code.md"
            }
          },
          {
            "id": "edit-code",
            "title": "Edit Code",
            "description": "Change the selected code by instructing Rubberduck to create an edit.",
            "media": {
              "markdown": "walkthrough/edit-code.md"
            }
          },
          {
            "id": "other-actions",
            "title": "Other Actions",
            "description": "Generate unit tests, explain code, find bugs, and more.",
            "media": {
              "markdown": "walkthrough/other-actions.md"
            }
          },
          {
            "id": "rubberduck-templates",
            "title": "Rubberduck Templates",
            "description": "Craft your own chat templates!",
            "media": {
              "markdown": "walkthrough/rubberduck-templates.md"
            }
          },
          {
            "id": "tips-and-tricks",
            "title": "Tips and Tricks",
            "description": "How to get the most out of Rubberduck.",
            "media": {
              "markdown": "walkthrough/tips-and-tricks.md"
            }
          },
          {
            "id": "project",
            "title": "Project",
            "description": "Learn more about the Rubberduck open source project.",
            "media": {
              "markdown": "walkthrough/project.md"
            }
          }
        ]
      }
    ]
  }
}
